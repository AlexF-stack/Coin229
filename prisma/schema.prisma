generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VendorStatus {
  actif
  en_attente
  suspendu
}

enum Categorie {
  montre
  bijou
  sac
  lunette
  chaussure
}

enum Genre {
  homme
  femme
  unisexe
}

enum ProductSource {
  local
  chine
}

enum ProductStatus {
  actif
  rupture
  archive
}

enum DeliveryZone {
  cotonou
  porto_novo
  godomey
}

enum OrderStatus {
  en_attente
  confirmee
  en_livraison
  livree
  annulee
}

enum PaymentMode {
  mobile_money
  livraison
}

model Vendor {
  id                String           @id @default(cuid())
  nomBoutique       String           @map("nom_boutique")
  contact           String
  email             String?          @unique
  passwordHash      String?          @map("password_hash")
  slug              String?          @unique
  description       String?
  logoUrl           String?          @map("logo_url")
  ifu               String?
  rccm              String?
  mobileMoney       String?          @map("mobile_money")
  termsAcceptedAt   DateTime?        @map("terms_accepted_at")
  resetTokenHash    String?          @map("reset_token_hash")
  resetTokenExpires DateTime?        @map("reset_token_expires")
  /// Demande « mot de passe oublié » en attente de traitement par l'admin
  resetRequestedAt  DateTime?        @map("reset_requested_at")
  /// Incrémenté à chaque changement de mot de passe : invalide toutes les sessions ouvertes
  sessionVersion    Int              @default(0) @map("session_version")
  statut            VendorStatus     @default(en_attente)
  dateCreation      DateTime         @default(now()) @map("date_creation")
  products          Product[]
  orders            Order[]
  conversations     Conversation[]
  payouts           VendorPayout[]
  pushSubscriptions PushSubscription[]

  @@index([resetTokenHash])
  @@map("vendors")
}

model Product {
  id             String        @id @default(cuid())
  vendorId       String        @map("vendor_id")
  nom            String
  description    String
  categorie      Categorie
  niche          String        @default("")
  genre          Genre
  prix           Int
  prixPromo      Int?          @map("prix_promo")
  stockQuantite  Int           @map("stock_quantite")
  source         ProductSource @default(local)
  images         String[]
  statut         ProductStatus @default(actif)
  /// Archivé à cause du statut du vendeur (en attente / suspendu), à remettre en vente à l'activation.
  /// Faux pour un produit retiré volontairement par le vendeur.
  heldByModeration Boolean     @default(false) @map("held_by_moderation")
  dateCreation   DateTime      @default(now()) @map("date_creation")
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  orderItems     OrderItem[]
  conversations  Conversation[]

  @@index([vendorId])
  @@index([categorie, genre, statut])
  @@index([niche])
  @@index([statut, dateCreation])
  @@map("products")
}

model Client {
  id                 String             @id @default(cuid())
  nom                String
  telephone          String?            @unique
  email              String?            @unique
  authId             String?            @unique @map("auth_id")
  /// Connexion email + mot de passe (scrypt) — null si le client passe par SMS / Google / Facebook
  passwordHash       String?            @map("password_hash")
  /// Incrémenté à chaque changement de mot de passe : invalide les sessions email ouvertes
  sessionVersion     Int                @default(0) @map("session_version")
  adresses           Address[]
  orders             Order[]
  pushSubscriptions  PushSubscription[]
  conversations      Conversation[]

  @@map("clients")
}

/** Abonnements Web Push (opt-in navigateur). */
/// Public d'un abonnement push : un même appareil peut être abonné à plusieurs
enum PushRole {
  client
  admin
  vendor
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String
  role      PushRole @default(client)
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  clientId  String?  @map("client_id")
  vendorId  String?  @map("vendor_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([endpoint, role])
  @@index([clientId])
  @@index([role])
  @@index([vendorId])
  @@map("push_subscriptions")
}

model Address {
  id              String       @id @default(cuid())
  clientId        String       @map("client_id")
  zone            DeliveryZone
  adresseComplete String       @map("adresse_complete")
  estPrincipale   Boolean      @default(false) @map("est_principale")
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("addresses")
}

model Order {
  id               String        @id @default(cuid())
  clientId         String        @map("client_id")
  vendorId         String        @map("vendor_id")
  statut           OrderStatus   @default(en_attente)
  modePaiement     PaymentMode   @map("mode_paiement")
  zoneLivraison    DeliveryZone  @map("zone_livraison")
  fraisLivraison   Int           @map("frais_livraison")
  montantTotal     Int           @map("montant_total")
  commissionPct    Int           @default(10) @map("commission_pct")
  commissionAmount Int           @default(0) @map("commission_amount")
  vendorNet        Int           @default(0) @map("vendor_net")
  refundStatus     RefundStatus? @map("refund_status")
  /// Raison d'annulation automatique, ex. "payment_timeout" (Mobile Money non payé à temps)
  cancelReason     String?       @map("cancel_reason")
  payoutId         String?       @map("payout_id")
  telephone        String
  nomClient        String        @map("nom_client")
  adresseLivraison String        @map("adresse_livraison")
  paymentProvider  String?       @map("payment_provider")
  paymentRef       String?       @unique @map("payment_ref")
  paymentUrl       String?       @map("payment_url")
  dateCreation     DateTime      @default(now()) @map("date_creation")
  client           Client        @relation(fields: [clientId], references: [id])
  vendor           Vendor        @relation(fields: [vendorId], references: [id])
  payout           VendorPayout? @relation(fields: [payoutId], references: [id])
  items            OrderItem[]
  conversations    Conversation[]

  @@index([clientId])
  // couvre aussi les recherches par vendeur seul (reversements, espace vendeur)
  @@index([vendorId, statut, payoutId])
  @@index([statut])
  @@index([payoutId])
  @@index([dateCreation])
  @@index([statut, modePaiement, dateCreation])
  @@map("orders")
}

/// Remboursement d'une commande payée en ligne puis annulée
enum RefundStatus {
  /// Rien à rembourser (paiement à la livraison ou non payé)
  not_applicable @map("n/a")
  pending
  done
}

enum PayoutStatus {
  pending
  paid
  cancelled
}

/** Reverse plateforme → vendeur (manuel ou batch). */
model VendorPayout {
  id           String       @id @default(cuid())
  vendorId     String       @map("vendor_id")
  amount       Int
  statut       PayoutStatus @default(pending)
  note         String?
  dateCreation DateTime     @default(now()) @map("date_creation")
  datePaid     DateTime?    @map("date_paid")
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  orders       Order[]

  @@index([vendorId, statut])
  @@map("vendor_payouts")
}

/** Rate-limit partagé multi-instance (Vercel). */
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start")

  @@map("rate_limit_buckets")
}

enum MessageSender {
  client
  vendor
}

/** Discussion 1:1 client ↔ vendeur (inbox marketplace). */
model Conversation {
  id             String    @id @default(cuid())
  vendorId       String    @map("vendor_id")
  clientId       String    @map("client_id")
  productId      String?   @map("product_id")
  orderId        String?   @map("order_id")
  subject        String?
  lastMessageAt  DateTime  @default(now()) @map("last_message_at")
  clientUnread   Int       @default(0) @map("client_unread")
  vendorUnread   Int       @default(0) @map("vendor_unread")
  createdAt      DateTime  @default(now()) @map("created_at")
  vendor         Vendor    @relation(fields: [vendorId], references: [id])
  client         Client    @relation(fields: [clientId], references: [id])
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([vendorId, clientId])
  @@index([vendorId, lastMessageAt])
  @@index([clientId, lastMessageAt])
  @@index([productId])
  @@index([orderId])
  @@map("conversations")
}

model Message {
  id             String          @id @default(cuid())
  conversationId String          @map("conversation_id")
  sender         MessageSender
  body           String
  createdAt      DateTime        @default(now()) @map("created_at")
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model AppConfig {
  id    String @id @default(cuid())
  cle   String @unique
  valeur String

  @@map("app_config")
}

model OrderItem {
  id                        String  @id @default(cuid())
  orderId                   String  @map("order_id")
  productId                 String  @map("product_id")
  quantite                  Int
  prixUnitaireAuMomentCommande Int  @map("prix_unitaire_au_moment_commande")
  order                     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
