# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Supabase Auth (OTP SMS + Google + Facebook)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Redirect allow-list Supabase Auth :
#   http://localhost:3000/auth/callback
#   https://coin229.vercel.app/auth/callback
# Providers : Dashboard → Authentication → Providers → Google / Facebook
# Google : Client ID + Secret (Google Cloud OAuth Web)
# Facebook : App ID + Secret (Meta for Developers)

# Admin back-office (obligatoire en prod — min. 12 car. recommandés, pas d’exemple)
ADMIN_PASSWORD="change-me-strong-password"
# Secrets de session — OBLIGATOIRES en production, 3 valeurs DIFFÉRENTES,
# ≥ 16 caractères, jamais le mot de passe admin ni ces exemples.
# En production, un secret manquant, partagé ou d'exemple désactive la session concernée.
# Générer chaque valeur : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET="remplacer-par-secret-admin-unique"
VENDOR_SESSION_SECRET="remplacer-par-secret-vendeur-unique"
# Session SMS client + cookie de confirmation de commande (requis pour le checkout)
PHONE_SESSION_SECRET="remplacer-par-secret-telephone-unique"
# Tâche planifiée Vercel (libération du stock des commandes Mobile Money non payées)
# Vercel l'envoie automatiquement dans « Authorization: Bearer … ». Même commande de génération.
CRON_SECRET="remplacer-par-secret-cron-unique"
# Boutique Coin229 (admin) — sinon slug coin229 / vendor_coin229_local
# COIN229_VENDOR_ID="vendor_coin229_local"

# Notif nouvelle commande / inscription / reset MDP (webhook Make/Zapier/n8n)
# ORDER_NOTIFY_WEBHOOK="https://hooks.example.com/coin229-order"

# Commission marketplace (% sur sous-total hors livraison)
# MARKETPLACE_COMMISSION_PCT=10

# Upload photos vendeur (Supabase Storage) — bucket public « product-images »
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_PRODUCT_BUCKET="product-images"

# Web Push (VAPID) — npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@coin229.bj
# Dev local PWA+push : ENABLE_PWA_DEV=1

# Flags (défaut : démo/mock autorisés hors production uniquement)
# ALLOW_DEMO_OTP=false
# ALLOW_DEMO_CATALOG=false
# ALLOW_PAYMENT_MOCK=false

# Paiement Mobile Money
# Fedapay (prioritaire) — https://dashboard.fedapay.com
# FEDAPAY_SECRET_KEY=sk_sandbox_xxx
# FEDAPAY_ENV=sandbox
# Clé secrète du webhook FedaPay (tableau de bord → Webhooks → « Copier la clé »).
# Vérifie l'en-tête X-FEDAPAY-SIGNATURE (t=…,s=…). Obligatoire en production.
# FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxx
# Webhook / callback : https://coin229.vercel.app/api/payments/fedapay/callback

# KkiaPay (alternatif widget) — https://app.kkiapay.me
# NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
# KKIAPAY_PRIVATE_KEY=
# KKIAPAY_SECRET=  # header x-kkiapay-secret — obligatoire en prod
# KKIAPAY_ENV=sandbox
# NEXT_PUBLIC_KKIAPAY_ENV=sandbox
# Webhook : https://coin229.vercel.app/api/payments/kkiapay/webhook

# Livraison (XOF / FCFA) — source UNIQUE, lue par le serveur ET le navigateur.
# (Les anciennes variables SHIPPING_FEE_* / FREE_SHIPPING_THRESHOLD ne sont plus lues.)
# Toute modification demande un redéploiement.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=25000
NEXT_PUBLIC_SHIPPING_FEE_COTONOU=1000
NEXT_PUBLIC_SHIPPING_FEE_PORTO_NOVO=1500
NEXT_PUBLIC_SHIPPING_FEE_GODOMEY=1500

# App
NEXT_PUBLIC_APP_NAME="Coin229"
NEXT_PUBLIC_APP_URL="https://coin229.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="22990000000"
NEXT_PUBLIC_CONTACT_PHONE="+229 90 00 00 00"
NEXT_PUBLIC_CONTACT_EMAIL="contact@coin229.bj"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/coin229"
# Identité légale (obligatoire en production — RCCM / IFU réels)
NEXT_PUBLIC_LEGAL_NAME="Coin229"
NEXT_PUBLIC_LEGAL_ADDRESS="Cotonou, Littoral, République du Bénin"
NEXT_PUBLIC_LEGAL_RCCM="En cours d'immatriculation"
NEXT_PUBLIC_LEGAL_IFU="En cours d'attribution"
